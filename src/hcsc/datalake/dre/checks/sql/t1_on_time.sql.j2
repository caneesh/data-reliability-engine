{# T1_ON_TIME: for each cadence slot whose SLA deadline falls in the window, is there a load
   in [slot, slot + SLA)? population = slots due; violations = slots with no load. #}
SELECT COUNT(*) AS population,
       SUM(CASE WHEN loads = 0 THEN 1 ELSE 0 END) AS violations
FROM (
  SELECT s.slot, COUNT(t.load_ts) AS loads
  FROM (SELECT explode(array({{ slots | join(', ') }})) AS slot) s
  LEFT JOIN (
    SELECT {{ load_expr }} AS load_ts
    FROM {{ table }}
{% if feed_filter %}
    WHERE {{ feed_filter }}
{% endif %}
  ) t
    ON t.load_ts >= s.slot AND t.load_ts < s.slot + INTERVAL {{ sla_minutes }} MINUTES
  GROUP BY s.slot
) per_slot
