{# table_contains probe: the distinct failure references in a configured table among rows
   matching its condition: base file names (by file) or key hashes (by key), using the
   upstream dataset's file name column or mapped key columns. #}
{# Only the failing refs are looked for (at most 100 per evaluation), so the rows collected are
   bounded by the failures, not by the table. #}
SELECT DISTINCT ref FROM (
  SELECT {% if by == "file" %}regexp_extract({{ column }}, '([^/]+)$', 1){% else %}{{ hash_fn }}({{ column }}){% endif %} AS ref
  FROM {{ table }}
  WHERE ({{ condition }})
) matching
WHERE ref IN ({{ refs | join(', ') }})
