{# HOP_LEDGER (Phase 1 build step 3; docs/design/reconciliation-model.md sections 2 and 3).
   p: parameters from checks/hop/ledger.py. All times are UTC TIMESTAMPs; the window end is the cutoff.

   mode assessed: one row per record the ledger accounts for or reports:
   - line 'due': each upstream key whose version under judgement (its latest by record time among the
     rows loaded before the cutoff; rows tied at it kept) has its deadline (that version's load time +
     sla_hours) in the window (at or before the window end on the full sweep), with its disposition
     (the first rule that matches, in the model's precedence), the disposition's label (the exclusion
     rule@version, the reject reason, the winner that supersedes it, why it is unassessable) and every explaining rule that matched
     (`matched`; the ones after the first are overlap diagnostics; the residual dispositions, delivered
     to missing, are D's state when no rule explains the record, so they never overlap); and each
     upstream row with no key in that range
     (unassessable, 'no key');
   - line 'pending': keys whose deadline is after the cutoff; 'untimed': candidate keys whose version
     under judgement has no usable load time (on the full sweep every such key is due instead, as
     unassessable 'no load time', and so is every keyless row with no load time);
   - line 'orphan': keys here loaded in the window that no upstream row has, and rows here with no key
     loaded in the window (only when every row here belongs to this hop: checks/hop/ledger.py
     orphans_unchecked).
   The check materialises it once and reads mode summary from it (`source`).
   mode summary: rows per (line, disposition, label) with how many rows and distinct keys, and the
   overlap pairs. #}
{% if mode == "assessed" %}
WITH up_rows AS (
  SELECT {{ p.up_key }} AS k, {{ p.up_raw }} AS raw_k, {{ p.up_keyed }} AS keyed,
         {{ p.up_record }} AS record_ts, {{ p.up_load }} AS load_ts,
         {% if p.tombstone %}coalesce(({{ p.tombstone }}), FALSE){% else %}FALSE{% endif %} AS tomb
{% if p.rejects and p.rejects.by_batch %}
       , {{ p.rejects.up_batch }} AS batch
{% endif %}
{% for x in p.exclusions %}
       , coalesce(({{ x.condition }}), FALSE) AS x_{{ loop.index }}
{% endfor %}
{% for c in p.owned %}
       , CAST({{ c.up }} AS STRING) AS u_{{ loop.index }}
{% endfor %}
  FROM {{ p.up_table }}
{% if p.up_filter %}
  WHERE {{ p.up_filter }}
{% endif %}
),
-- as of the cutoff: a row loaded after the window end belongs to a later window
up_cut AS (
  SELECT * FROM up_rows WHERE load_ts IS NULL OR load_ts < {{ p.window_end }}
),
{% if p.full_sweep %}
up_cand AS (SELECT * FROM up_cut WHERE keyed),
{% else %}
-- only keys with a row loaded since the judged range began can be due or pending; this narrows the
-- work, not the answer (a key's every version is still read to find its latest)
up_cand AS (
  SELECT u.* FROM up_cut u
  JOIN (SELECT DISTINCT k FROM up_cut WHERE keyed AND load_ts >= {{ p.deadline_start }}) c ON c.k = u.k
  WHERE u.keyed
),
{% endif %}
up_ranked AS (
  SELECT u.*, MAX(record_ts) OVER (PARTITION BY k) AS top_ts,
         size(collect_set(raw_k) OVER (PARTITION BY k)) AS raw_variants
  FROM up_cand u
),
up_top AS (
  SELECT * FROM up_ranked WHERE record_ts = top_ts OR top_ts IS NULL
),
up_keys AS (
  SELECT k, MAX(record_ts) AS up_record_ts, MAX(load_ts) AS up_load_ts, MAX(raw_variants) AS up_variants,
         COUNT(*) AS up_tied,
         MAX(CASE WHEN tomb THEN 1 ELSE 0 END) AS tomb
{% for x in p.exclusions %}
       , MAX(CASE WHEN x_{{ loop.index }} THEN 1 ELSE 0 END) AS x_{{ loop.index }}
{% endfor %}
  FROM up_top GROUP BY k
),
due_keys AS (
  SELECT * FROM up_keys
{% if p.full_sweep %}
  -- the full sweep also judges keys with no usable load time: unassessable, never lost silently
  WHERE up_load_ts < {{ p.deadline_end }} OR up_load_ts IS NULL
{% else %}
  WHERE up_load_ts < {{ p.deadline_end }} AND up_load_ts >= {{ p.deadline_start }}
{% endif %}
),
dn_rows AS (
  SELECT {{ p.dn_key }} AS k, {{ p.dn_raw }} AS raw_k, {{ p.dn_keyed }} AS keyed, {{ p.dn_record }} AS record_ts,
         {% if p.dn_load %}{{ p.dn_load }}{% else %}CAST(NULL AS TIMESTAMP){% endif %} AS load_ts,
         {% if p.soft_when %}coalesce(({{ p.soft_when }}), FALSE){% else %}FALSE{% endif %} AS soft
{% for c in p.owned %}
       , CAST({{ c.dn }} AS STRING) AS d_{{ loop.index }}
{% endfor %}
  FROM {{ p.dn_table }}
{% if p.dn_filter %}
  WHERE {{ p.dn_filter }}
{% endif %}
{% if p.as_of %}
  -- AS_OF_REPLAY (ADR-05): only rows loaded before the cutoff, as this append-only table stood then
  {% if p.dn_filter %}AND{% else %}WHERE{% endif %} {{ p.dn_load }} < {{ p.as_of }}
{% endif %}
),
dn_cand AS (
  SELECT d.* FROM dn_rows d JOIN due_keys u ON u.k = d.k WHERE d.keyed
),
dn_ranked AS (
  SELECT d.*, MAX(record_ts) OVER (PARTITION BY k) AS top_ts,
         size(collect_set(raw_k) OVER (PARTITION BY k)) AS raw_variants
  FROM dn_cand d
),
dn_top AS (
  SELECT * FROM dn_ranked WHERE record_ts = top_ts OR top_ts IS NULL
),
dn_keys AS (
  SELECT k, MAX(record_ts) AS dn_record_ts, MAX(raw_variants) AS dn_variants, COUNT(*) AS dn_tied,
         MAX(CASE WHEN record_ts IS NULL THEN 1 ELSE 0 END) AS dn_untimed,
         MAX(CASE WHEN soft THEN 1 ELSE 0 END) AS soft
  FROM dn_top GROUP BY k
),
{% if p.owned %}
-- the mapped values at the version, as sets over the rows tied at it on each side (as HOP_VALUE_AGREEMENT)
up_sets AS (
  SELECT k, array_sort(collect_set(to_json(named_struct({% for c in p.owned %}'c{{ loop.index }}', u_{{ loop.index }}{% if not loop.last %}, {% endif %}{% endfor %})))) AS vals
  FROM up_top GROUP BY k
),
dn_sets AS (
  SELECT k, array_sort(collect_set(to_json(named_struct({% for c in p.owned %}'c{{ loop.index }}', d_{{ loop.index }}{% if not loop.last %}, {% endif %}{% endfor %})))) AS vals
  FROM dn_top GROUP BY k
),
{% endif %}
{% for w in p.winners %}
{% set wi = loop.index %}
-- survivorship (build step 5; model section 6.3): {{ w.label }}, ahead of this upstream in precedence,
-- delivers a due key when its latest version as of the cutoff (rows tied at it kept) is what this
-- dataset holds, compared as `delivered` is: this version or a newer one here, and the mapped values agree
w{{ wi }}_rows AS (
  SELECT {{ w.key }} AS k, {{ w.record }} AS record_ts
{% for c in w.owned %}
       , CAST({{ c }} AS STRING) AS u_{{ loop.index }}
{% endfor %}
  FROM {{ w.table }}
  WHERE {{ w.keyed }}{% if w.filter %} AND {{ w.filter }}{% endif %}{% if w.load %} AND ({{ w.load }} IS NULL OR {{ w.load }} < {{ p.window_end }}){% endif %}

),
w{{ wi }}_top AS (
  SELECT t.* FROM (SELECT r.*, MAX(r.record_ts) OVER (PARTITION BY r.k) AS top_ts
                   FROM w{{ wi }}_rows r JOIN due_keys d ON d.k = r.k) t
  WHERE t.record_ts = t.top_ts
),
w{{ wi }}_keys AS (
  SELECT k, MAX(record_ts) AS w_record_ts
{% if p.owned %}
       , array_sort(collect_set(to_json(named_struct({% for c in w.owned %}'c{{ loop.index }}', u_{{ loop.index }}{% if not loop.last %}, {% endif %}{% endfor %})))) AS vals
{% endif %}
  FROM w{{ wi }}_top GROUP BY k
),
{% endfor %}
{% if p.rejects %}
-- reported evidence (checkpoint 3, C3-01): a reject accounts for the version under judgement only when
-- its key and its lineage (the refused record's version, or its batch) match that version, and it was
-- rejected before the cutoff; the latest such reject names the reason and the rule. A reject of the key
-- whose lineage is empty cannot be attributed to any version: the record is unassessable. A reject
-- naming another version explains nothing about this one.
rejects AS (
  SELECT {{ p.rejects.key }} AS k, CAST({{ p.rejects.reason }} AS STRING) AS reason, {{ p.rejects.time }} AS rejected_ts,
         {{ p.rejects.lineage }} AS lineage,
         {% if p.rejects.rule %}{{ p.rejects.rule }}{% else %}CAST(NULL AS STRING){% endif %} AS rule
  FROM {{ p.rejects.table }}
  WHERE {{ p.rejects.time }} < {{ p.window_end }}{% if p.rejects.filter %} AND ({{ p.rejects.filter }}){% endif %}

),
rejected AS (
  SELECT d.k, max_by(named_struct('reason', r.reason, 'rule', r.rule), r.rejected_ts) AS latest
  FROM due_keys d
{% if p.rejects.by_batch %}
  JOIN (SELECT DISTINCT k, batch FROM up_top) b ON b.k = d.k
  JOIN rejects r ON r.k = d.k AND r.lineage = b.batch
{% else %}
  JOIN rejects r ON r.k = d.k AND r.lineage = d.up_record_ts
{% endif %}
  GROUP BY d.k
),
unattributed AS (
  SELECT DISTINCT d.k FROM due_keys d JOIN rejects r ON r.k = d.k WHERE r.lineage IS NULL
),
{% endif %}
judged AS (
  SELECT d.k, d.up_record_ts, n.dn_record_ts, n.k IS NOT NULL AS present, d.tomb = 1 AS tomb,
         CASE WHEN d.up_variants > 1 OR coalesce(n.dn_variants, 1) > 1 THEN 'key collision'
{% if p.one_to_one %}
              -- identity (L4): one record each side; rows tied at the version on either side are not
              WHEN d.up_tied > 1 OR coalesce(n.dn_tied, 1) > 1 THEN 'not one-to-one'
{% endif %}
              WHEN d.up_record_ts IS NULL OR n.dn_untimed = 1 THEN 'no record time'
              WHEN d.up_load_ts IS NULL THEN 'no load time'
{% if p.rejects %}
              -- only for a record absent here: a record present here is not explained by a reject
              WHEN r.k IS NULL AND ua.k IS NOT NULL AND n.k IS NULL THEN 'reject not attributable to a version'
{% if p.rejects.rules_required %}
              WHEN r.latest.reason IN ({% for x in p.rejects.rules_required %}'{{ x }}'{% if not loop.last %}, {% endif %}{% endfor %})
                   AND r.latest.rule IS NULL THEN 'reject names no rule'
{% endif %}
{% endif %}
              END AS unknown_reason,
         {% if p.exclusions %}CASE {% for x in p.exclusions %}WHEN d.x_{{ loop.index }} = 1 THEN '{{ x.label }}' {% endfor %}END{% else %}CAST(NULL AS STRING){% endif %} AS excluded_by,
         {% if p.rejects %}r.latest.reason{% else %}CAST(NULL AS STRING){% endif %} AS reject_reason,
         {% if p.rejects %}r.latest.rule{% else %}CAST(NULL AS STRING){% endif %} AS reject_rule,
         {% if p.owned %}us.vals <> ds.vals{% else %}FALSE{% endif %} AS diverges,
         coalesce(n.soft = 1, FALSE) AS soft_applied,
         -- the first upstream ahead in precedence that delivers the key here (survivorship only)
         {% if p.winners %}CASE {% for w in p.winners %}WHEN w{{ loop.index }}.k IS NOT NULL AND n.k IS NOT NULL AND n.dn_record_ts >= w{{ loop.index }}.w_record_ts{% if p.owned %} AND w{{ loop.index }}.vals = ds.vals{% endif %} THEN '{{ w.label }}' {% endfor %}END{% else %}CAST(NULL AS STRING){% endif %} AS superseded_by
  FROM due_keys d
  LEFT JOIN dn_keys n ON n.k = d.k
{% for w in p.winners %}
  LEFT JOIN w{{ loop.index }}_keys w{{ loop.index }} ON w{{ loop.index }}.k = d.k
{% endfor %}
{% if p.owned %}
  LEFT JOIN up_sets us ON us.k = d.k
  LEFT JOIN dn_sets ds ON ds.k = d.k
{% endif %}
{% if p.rejects %}
  LEFT JOIN rejected r ON r.k = d.k
  LEFT JOIN unattributed ua ON ua.k = d.k
{% endif %}
),
ledger AS (
  -- matched: the explaining rules (1 to 6) that hold, in precedence; the residual (delivered,
  -- divergent, stale, missing) is what D shows when none of them does
  SELECT k, unknown_reason, excluded_by, reject_reason, reject_rule, superseded_by,
         filter(array(
           CASE WHEN unknown_reason IS NOT NULL THEN 'unassessable' END,
{% if p.applied_as == "soft" %}
           CASE WHEN tomb AND present AND soft_applied THEN 'deleted' END,
{% else %}
           CASE WHEN tomb AND NOT present THEN 'deleted' END,
{% endif %}
           -- survivorship: the record here is the winner's, so this edge's presence rules do not judge it
           CASE WHEN superseded_by IS NOT NULL THEN 'superseded' END,
{% if p.applied_as == "soft" %}
           CASE WHEN tomb AND present AND NOT soft_applied THEN 'deleted_not_applied' END,
{% else %}
           CASE WHEN tomb AND present THEN 'deleted_not_applied' END,
{% endif %}
           CASE WHEN excluded_by IS NOT NULL AND NOT present THEN 'excluded' END,
           CASE WHEN excluded_by IS NOT NULL AND present THEN 'excluded_but_present' END,
           CASE WHEN reject_reason IS NOT NULL THEN 'rejected' END
         ), x -> x IS NOT NULL) AS matched,
         CASE WHEN NOT present THEN 'missing'
              WHEN dn_record_ts < up_record_ts THEN 'stale'
              WHEN dn_record_ts >= up_record_ts AND coalesce(diverges, TRUE) THEN 'divergent'
              WHEN dn_record_ts >= up_record_ts THEN 'delivered' END AS residual
  FROM judged
),
placed AS (
  SELECT k, coalesce(element_at(matched, 1), residual) AS disposition, unknown_reason, excluded_by, reject_reason,
         reject_rule, superseded_by, matched
  FROM ledger
)
SELECT 'due' AS line, k, disposition,
       CASE disposition WHEN 'unassessable' THEN unknown_reason
                        WHEN 'excluded' THEN excluded_by
                        WHEN 'excluded_but_present' THEN excluded_by
                        WHEN 'superseded' THEN superseded_by
                        WHEN 'rejected' THEN concat_ws(' ', reject_reason, reject_rule) END AS label,
       -- a reject's class under the policy: authorised only for a reason the policy authorises and, where
       -- the policy lists rules, a rule it lists; every other reason, or rule, is a defect (ADR-04)
       CASE WHEN disposition <> 'rejected' THEN CAST(NULL AS STRING)
{% if p.rejects and p.rejects.authorised %}
            WHEN concat_ws(' ', reject_reason, reject_rule) IN ({% for x in p.rejects.authorised %}'{{ x }}'{% if not loop.last %}, {% endif %}{% endfor %})
              THEN 'authorised'
{% endif %}
{% if p.rejects and p.rejects.authorised_any %}
            WHEN reject_reason IN ({% for x in p.rejects.authorised_any %}'{{ x }}'{% if not loop.last %}, {% endif %}{% endfor %})
              THEN 'authorised'
{% endif %}
            ELSE 'defect' END AS variant,
       matched
FROM placed
UNION ALL
SELECT 'due' AS line, CAST(NULL AS STRING) AS k, 'unassessable' AS disposition, 'no key' AS label,
       CAST(NULL AS STRING) AS variant, array('unassessable') AS matched
FROM up_cut
WHERE NOT keyed AND {% if p.full_sweep %}(load_ts < {{ p.deadline_end }} OR load_ts IS NULL){% else %}load_ts < {{ p.deadline_end }} AND load_ts >= {{ p.deadline_start }}{% endif %}

UNION ALL
SELECT 'pending' AS line, k, CAST(NULL AS STRING) AS disposition, CAST(NULL AS STRING) AS label,
       CAST(NULL AS STRING) AS variant, CAST(array() AS ARRAY<STRING>) AS matched
FROM up_keys WHERE up_load_ts >= {{ p.pending_from }}
{% if not p.full_sweep %}
UNION ALL
SELECT 'untimed' AS line, k, CAST(NULL AS STRING) AS disposition, CAST(NULL AS STRING) AS label,
       CAST(NULL AS STRING) AS variant, CAST(array() AS ARRAY<STRING>) AS matched
FROM up_keys WHERE up_load_ts IS NULL
{% endif %}
{% if p.orphans %}
UNION ALL
SELECT 'orphan' AS line, o.k, CAST(NULL AS STRING) AS disposition, CAST(NULL AS STRING) AS label,
       CAST(NULL AS STRING) AS variant, CAST(array() AS ARRAY<STRING>) AS matched
FROM (SELECT DISTINCT k FROM dn_rows
      WHERE keyed AND load_ts >= {{ p.window_start }} AND load_ts < {{ p.window_end }}) o
LEFT ANTI JOIN (SELECT DISTINCT k FROM up_rows WHERE keyed) u ON u.k = o.k
UNION ALL
SELECT 'orphan' AS line, CAST(NULL AS STRING) AS k, CAST(NULL AS STRING) AS disposition, 'no key' AS label,
       CAST(NULL AS STRING) AS variant, CAST(array() AS ARRAY<STRING>) AS matched
FROM dn_rows WHERE NOT keyed AND load_ts >= {{ p.window_start }} AND load_ts < {{ p.window_end }}
{% endif %}
{% else %}
SELECT line, disposition, label, variant, COUNT(*) AS n, COUNT(DISTINCT k) AS keys
FROM {{ source }}
GROUP BY line, disposition, label, variant
UNION ALL
SELECT 'overlap' AS line, disposition, later AS label, CAST(NULL AS STRING) AS variant, COUNT(*) AS n, COUNT(*) AS keys
FROM (SELECT disposition, explode(slice(matched, 2, size(matched) - 1)) AS later FROM {{ source }}
      WHERE size(matched) > 1) o
GROUP BY disposition, later
{% endif %}
