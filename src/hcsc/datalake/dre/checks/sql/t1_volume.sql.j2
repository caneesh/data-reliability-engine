{# T1_VOLUME: rows loaded in each slot's period [slot, next slot), for the slots whose period ends
   in the window, against the median of the slot label's last {{ limit }} earlier loads.
   History: this dataset's earlier NORMAL T1_VOLUME results that counted rows (evaluated, or
   baseline), one per load (slot_time), the latest judgement of a load re-judged in a held window;
   newest first by window end. One row per slot with rows: g_1 = slot label (local HH:MM),
   g_2 = slot time, row_count, loads (history size), median_rows, low, high, and outside (1 or 0;
   null with fewer than {{ min_history }} earlier loads). #}
WITH periods AS (
  SELECT inline(array(
{% for p in periods %}
    named_struct('label', '{{ p.label }}', 'slot_time', '{{ p.slot_time }}', 'start_ts', {{ p.start }}, 'end_ts', {{ p.end }}){% if not loop.last %},{% endif %}

{% endfor %}
  ))
),
loaded AS (
  SELECT {{ load_expr }} AS load_ts
  FROM {{ table }}
{% if feed_filter %}
  WHERE {{ feed_filter }}
{% endif %}
),
counts AS (
  SELECT p.label, p.slot_time, COUNT(t.load_ts) AS row_count
  FROM periods p
  LEFT JOIN loaded t ON t.load_ts >= p.start_ts AND t.load_ts < p.end_ts
  GROUP BY p.label, p.slot_time
),
per_load AS (
  SELECT group_values['slot'] AS label, group_values['slot_time'] AS slot_time,
         max_by(population, window_end) AS row_count, MAX(window_end) AS window_end
  FROM {{ dq_database }}.dq_check_result
  WHERE dataset = '{{ dataset }}'
    AND check_id = 'T1_VOLUME'
    AND execution_type = 'NORMAL'
    AND population > 0
    AND (state IN ('PASSED', 'FAILED') OR reason_code = 'insufficient_history')
    AND window_end <= {{ before }}
    AND group_values['slot'] IN ({% for p in periods %}'{{ p.label }}'{% if not loop.last %}, {% endif %}{% endfor %})
  GROUP BY group_values['slot'], group_values['slot_time']
),
history AS (
  SELECT label, row_count
  FROM (SELECT per_load.*, ROW_NUMBER() OVER (PARTITION BY label ORDER BY window_end DESC) AS rn FROM per_load) ranked
  WHERE rn <= {{ limit }}
),
stats AS (
  SELECT label, COUNT(*) AS loads, percentile(row_count, 0.5) AS median_rows FROM history GROUP BY label
)
SELECT c.label AS g_1, c.slot_time AS g_2, c.row_count, COALESCE(s.loads, 0) AS loads, s.median_rows,
       s.median_rows * {{ low_factor }} AS low, s.median_rows * {{ high_factor }} AS high,
       CASE WHEN COALESCE(s.loads, 0) < {{ min_history }} THEN NULL
            WHEN c.row_count BETWEEN s.median_rows * {{ low_factor }} AND s.median_rows * {{ high_factor }} THEN 0
            ELSE 1 END AS outside
FROM counts c
LEFT JOIN stats s ON s.label = c.label
WHERE c.row_count > 0
